{
  "name": "bilingual-curation-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "mock:ai": "node scripts/mock-ai-provider.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply bilingual-curation-workflow --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "prod:preflight": "node scripts/production-preflight.mjs wrangler.production.toml",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  }
}
